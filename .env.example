EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Set these in the Convex deployment, never in EXPO_PUBLIC_* variables.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Comma-separated production web origins. Local Expo Web origins are added only
# when CONVEX_SITE_URL points at localhost or 127.0.0.1.
BETTER_AUTH_TRUSTED_ORIGINS=
# Expo Web origin used by the Better Auth cross-domain session plugin.
SITE_URL=http://localhost:8081
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Self-hosted Convex CLI credentials (copy to .env.local).
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
