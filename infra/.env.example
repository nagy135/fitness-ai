PORT=3210
SITE_PROXY_PORT=3211
DASHBOARD_PORT=6791

# Set this to an official Convex release tag to pin infrastructure updates.
CONVEX_REV=latest

# Replace 127.0.0.1 with the host LAN IP when using a physical device.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210
