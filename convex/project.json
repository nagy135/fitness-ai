{
  "name": "convex",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "convex",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "./scripts/convex-self-hosted.sh dev" }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": { "command": "./scripts/convex-self-hosted.sh deploy" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p convex/tsconfig.json --noEmit" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run convex --passWithNoTests" }
    }
  },
  "tags": ["scope:backend", "type:app"]
}
