{
  "expo": {
    "name": "Fitness AI",
    "slug": "fitness-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fitnessai.app"
    },
    "android": {
      "package": "com.fitnessai.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFB38C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Fitness AI to use your microphone to dictate workout prompts.",
          "speechRecognitionPermission": "Allow Fitness AI to turn your speech into editable prompt text."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFB38C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "nagy135"
  }
}
